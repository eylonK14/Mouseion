# ---------------------------------------------------------------------------
# Mouseion — Phase 1 configuration
#
# Copy to .env and fill in the blanks:   cp .env.example .env
# Every variable the stack reads is listed here. Values shown are the defaults
# baked into backend/src/mouseion/config.py; uncommented lines are required.
# ---------------------------------------------------------------------------

# --- Auth -------------------------------------------------------------------
# Bearer token required by every /api/* route (CLAUDE.md: single user, but the
# API is reachable from a phone over Tailscale). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-before-first-run

# --- LLM routing (OpenRouter) ----------------------------------------------
# ALL LLM calls go through OpenRouter, including PageIndex's internal calls.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cheap/fast model: ingest-time tagging + summaries + PageIndex tree building.
MODEL_INGEST=anthropic/claude-haiku-4.5
# Frontier model: QA and test-mode grading. Unused in Phase 1, wired in Phase 3.
MODEL_QA=anthropic/claude-opus-4.5

# Optional attribution headers OpenRouter shows on your dashboard.
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=Mouseion

# Seconds; ingest LLM calls can be slow on long papers.
LLM_TIMEOUT_SECONDS=180
# Structured-output calls are retried once on Pydantic validation failure
# (CLAUDE.md convention). This is the total number of attempts.
LLM_MAX_ATTEMPTS=2

# --- Embeddings (LOCAL — no embedding API calls, ever) ----------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the model's output dimension AND the vec0 table built by
# migration 001. Changing this requires a new migration (see PROJECT_NOTES.md).
EMBEDDING_DIM=384

# --- Tree index (PageIndex) -------------------------------------------------
# auto     — use PageIndex when it is importable and an OpenRouter key is set,
#            otherwise fall back to the built-in heuristic indexer
# pageindex— require PageIndex; fail the step if it is unavailable
# heuristic— always use the PyMuPDF outline/heading indexer (no LLM calls)
TREE_INDEXER=auto
# Passed to PageIndex; "flash" is cheaper/faster, "standard" is more thorough.
PAGEINDEX_MODE=flash

# --- Storage ----------------------------------------------------------------
# Content-addressed PDFs live in $DATA_DIR/pdfs, trees in $DATA_DIR/trees.
DATA_DIR=/app/data
DB_PATH=/app/data/library.db

# --- Queue ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Ingest limits ----------------------------------------------------------
MAX_UPLOAD_MB=64
HTTP_TIMEOUT_SECONDS=60
ARXIV_API_BASE=http://export.arxiv.org/api/query
# Character budget for the paper text handed to the combined ingest LLM call.
# Longer papers are bounded as: head + extracted section headers (see
# services/prompts.py::bound_paper_text).
INGEST_TEXT_BUDGET_CHARS=24000

# --- App --------------------------------------------------------------------
# Host ports published by docker-compose.yml.
API_PORT=8000
WEBUI_PORT=3000

LOG_LEVEL=INFO
# Holds templates/ (Jinja) and static/ (CSS + JS) for the web UI.
FRONTEND_DIR=/app/frontend

# Where Open WebUI is reachable FROM THE BROWSER — not from inside the compose
# network. Phase 2 only records it; Phase 3 turns the paper detail page's "Ask
# about this paper" / "Test me" buttons into deep links that open a chat
# pre-filled with a `[paper:{id}]`-prefixed message.
OPENWEBUI_BASE_URL=http://localhost:3000
