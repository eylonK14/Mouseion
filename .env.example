# ---------------------------------------------------------------------------
# Mouseion — complete configuration through Phase 5
#
# Copy to .env and fill in the blanks:   cp .env.example .env
# Every variable the stack reads is listed here. Values shown are the defaults
# baked into backend/src/mouseion/config.py; uncommented lines are required.
# ---------------------------------------------------------------------------

# --- Auth -------------------------------------------------------------------
# Bearer token required by every /api/* route (CLAUDE.md: single user, but the
# API is reachable from a phone over Tailscale). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-before-first-run
# One-time phone pairing links expire quickly and cannot be reused.
PAIRING_TOKEN_TTL_MINUTES=10

# --- LLM routing (OpenRouter) ----------------------------------------------
# ALL LLM calls go through OpenRouter, including PageIndex's internal calls.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cheap/fast model: ingest-time tagging + summaries + PageIndex tree building.
MODEL_INGEST=anthropic/claude-haiku-4.5
# Frontier model: grounded QA, examiner probing, and rubric grading.
MODEL_QA=anthropic/claude-opus-4.5

# Optional attribution headers OpenRouter shows on your dashboard.
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=Mouseion

# Seconds; ingest LLM calls can be slow on long papers.
LLM_TIMEOUT_SECONDS=180
# Total attempts for structured-output validation and for transient OpenRouter
# transport failures that occur before any response token reaches the user.
LLM_MAX_ATTEMPTS=2

# --- Grounded QA -----------------------------------------------------------
# Stage-1 hybrid shortlist size (local vector search + FTS reciprocal-rank
# fusion). Stage 2 spends at most QA_MAX_NAVIGATIONS MODEL_QA calls selecting
# sections; synthesis is one additional MODEL_QA call.
QA_CANDIDATE_K=8
QA_MAX_NAVIGATIONS=4
QA_SECTIONS_PER_PAPER=3
# Hard character budgets for all synthesized grounding, one paper's excerpts,
# and one tree-navigation prompt. History is bounded by both count and chars.
QA_CONTEXT_BUDGET_CHARS=48000
QA_SECTION_BUDGET_CHARS=12000
QA_TREE_BUDGET_CHARS=16000
QA_HISTORY_MESSAGES=12
QA_HISTORY_BUDGET_CHARS=12000

# --- Examiner mode ---------------------------------------------------------
# User turns include the initial explanation and every probe response. Reaching
# the cap grades the transcript immediately instead of leaving a session open.
TEST_MAX_TURNS=8
# Active sessions are lazily finalized on their next read/turn after this age.
TEST_SESSION_TTL_HOURS=72
# A completed score at or above this value offers (but never applies) the
# one-click reading-status change to `understood`.
TEST_UNDERSTOOD_THRESHOLD=4

# --- Embeddings (LOCAL — no embedding API calls, ever) ----------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the model's output dimension AND the vec0 table built by
# migration 001. Changing this requires a new migration (see PROJECT_NOTES.md).
EMBEDDING_DIM=384

# --- Tree index (PageIndex) -------------------------------------------------
# auto     — use PageIndex when it is importable and an OpenRouter key is set,
#            otherwise fall back to the built-in heuristic indexer
# pageindex— require PageIndex; fail the step if it is unavailable
# heuristic— always use the PyMuPDF outline/heading indexer (no LLM calls)
TREE_INDEXER=auto
# Passed to PageIndex; "flash" is cheaper/faster, "standard" is more thorough.
PAGEINDEX_MODE=flash

# --- Storage ----------------------------------------------------------------
# Content-addressed PDFs live in $DATA_DIR/pdfs, trees in $DATA_DIR/trees.
DATA_DIR=/app/data
DB_PATH=/app/data/library.db
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
# Host path mounted at BACKUP_DIR by Compose; keep it on a separately backed-up disk if possible.
BACKUP_HOST_DIR=./backups

# --- Queue ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Ingest limits ----------------------------------------------------------
MAX_UPLOAD_MB=64
# Per API process and client address; deliberately modest because this route is
# phone-reachable even though it remains bearer-token protected.
INGEST_RATE_LIMIT_COUNT=20
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
HTTP_TIMEOUT_SECONDS=60
ARXIV_API_BASE=http://export.arxiv.org/api/query
# Character budget for the paper text handed to the combined ingest LLM call.
# Longer papers are bounded as: head + extracted section headers (see
# services/prompts.py::bound_paper_text).
INGEST_TEXT_BUDGET_CHARS=24000

# --- App --------------------------------------------------------------------
# Host ports published by docker-compose.yml.
API_PORT=8000
WEBUI_PORT=3000

LOG_LEVEL=INFO
# Holds templates/ (Jinja) and static/ (CSS + JS) for the web UI.
FRONTEND_DIR=/app/frontend
# Canonical browser-facing URL used in phone pairing QR codes. In production,
# set this to the Tailscale HTTPS URL (for example https://mouseion.tailnet.ts.net).
# Empty falls back to the current request origin, which is convenient locally.
PUBLIC_BASE_URL=
HEALTH_OPENROUTER_TIMEOUT_SECONDS=5
HEALTH_MIN_FREE_DISK_MB=1024

# Where Open WebUI is reachable FROM THE BROWSER — not from inside the compose
# network. Paper-detail buttons open the `single_paper` and `test_me` Pipe
# Functions with `[paper:{id}]` and `[test:{id}]` scope locks.
OPENWEBUI_BASE_URL=http://localhost:3000
